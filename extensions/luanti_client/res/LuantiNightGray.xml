    <command type="quad" tag="NightGray" vs="luanti_client/res/LuantiNightGray" ps="luanti_client/res/LuantiNightGray" output="viewport">
        <parameter name="NightGray" value="0.02 0.2" />
        <texture unit="diffuse" name="viewport" />
    </command>
</renderpath>
