<!-- CoreData has PBRDiff and DiffVCol but not the combination, and voxel
     geometry needs both: PBR shading, plus the per-voxel skylight the mesher
     writes into vertex colors. IBL is left out of the defines because nothing
     sets a zone cube map; the zone's ambient color is the whole sky term. -->
<technique vs="PBRLitSolid" ps="PBRLitSolid" vsdefines="VERTEXCOLOR" psdefines="DIFFMAP PBR VERTEXCOLOR">
    <pass name="base" />
    <pass name="litbase" psdefines="AMBIENT" />
    <pass name="light" depthtest="equal" depthwrite="false" blend="add" />
    <pass name="material" psdefines="MATERIAL" depthtest="equal" depthwrite="false" />
    <pass name="deferred" psdefines="DEFERRED" blend="add" />
    <pass name="depth" vs="Depth" ps="Depth" />
    <pass name="shadow" vs="Shadow" ps="Shadow" />
</technique>
