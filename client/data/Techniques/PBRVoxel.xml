<!-- Voxel geometry shaded by the skylight the mesher packed into vertex
     colors. See Shaders/GLSL/PBRVoxel.glsl for what the colors mean. IBL is
     left out of the defines because nothing sets a zone cube map; the zone's
     ambient color is the whole sky term. -->
<technique vs="PBRVoxel" ps="PBRVoxel" psdefines="DIFFMAP PBR">
    <pass name="base" />
    <pass name="light" depthtest="equal" depthwrite="false" blend="add" />
    <pass name="depth" vs="Depth" ps="Depth" />
    <pass name="shadow" vs="Shadow" ps="Shadow" />
</technique>
