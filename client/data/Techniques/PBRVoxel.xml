<!-- Voxel geometry shaded by the skylight the mesher packed into vertex
     colors. See Shaders/GLSL/PBRVoxel.glsl for what the colors mean.

     METALLIC reads the roughness/metalness atlas the atlas registry derives
     from each texture, VOXELNORMALMAP the normal atlas beside it, VOXELIBL
     reflects the zone cube map and VOXELTRANSLUCENCY lets light through a
     surface from behind. A world that sets no zone cube map gets black
     reflections, so IBL is only useful together with Zone.zoneTexture. -->
<technique vs="PBRVoxel" ps="PBRVoxel"
        psdefines="DIFFMAP PBR METALLIC VOXELNORMALMAP VOXELIBL VOXELTRANSLUCENCY">
    <pass name="base" />
    <pass name="light" depthtest="equal" depthwrite="false" blend="add" />
    <pass name="depth" vs="Depth" ps="Depth" />
    <pass name="shadow" vs="Shadow" ps="Shadow" />
</technique>
