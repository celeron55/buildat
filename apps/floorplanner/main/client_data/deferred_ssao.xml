<!-- The 3D view under PBR: Urho3D's Deferred.xml with ambient occlusion
     ([FP_AO], see Ssao.glsl) between the G-buffer and the lights. At that
     point the viewport holds only what the G-buffer pass lit -- the
     ambient, the reflection and the emissive -- so multiplying it by the
     occlusion darkens the ambient in corners and leaves the sun and the
     lamps, which the light volumes add after, as they are. -->
<renderpath>
    <rendertarget name="albedo" sizedivisor="1 1" format="rgba" />
    <rendertarget name="normal" sizedivisor="1 1" format="rgba" />
    <rendertarget name="depth" sizedivisor="1 1" format="lineardepth" />
    <rendertarget name="ssao" tag="Ssao" sizedivisor="2 2" format="rgba" filter="true" />
    <command type="clear" color="1 1 1 1" output="depth" />
    <command type="clear" color="fog" depth="1.0" stencil="0" />
    <command type="scenepass" pass="deferred" marktostencil="true" vertexlights="true" metadata="gbuffer">
        <output index="0" name="viewport" />
        <output index="1" name="albedo" />
        <output index="2" name="normal" />
        <output index="3" name="depth" />
    </command>
    <!-- The radius and the strength fitted to a path-traced room's edges
         (apps/floorplanner/test/pathtrace_render.py, 2026-10-02) -->
    <command type="quad" tag="Ssao" vs="main/Ssao" ps="main/Ssao" psdefines="AO" output="ssao">
        <parameter name="SsaoRadius" value="0.8" />
        <parameter name="SsaoStrength" value="1.6" />
        <texture unit="depth" name="depth" />
        <texture unit="normal" name="normal" />
    </command>
    <command type="quad" tag="Ssao" vs="main/Ssao" ps="main/Ssao" psdefines="APPLY" blend="multiply" output="viewport">
        <texture unit="diffuse" name="ssao" />
        <texture unit="depth" name="depth" />
    </command>
    <command type="lightvolumes" vs="DeferredLight" ps="DeferredLight">
        <texture unit="albedo" name="albedo" />
        <texture unit="normal" name="normal" />
        <texture unit="depth" name="depth" />
    </command>
    <command type="scenepass" pass="postopaque" />
    <command type="scenepass" pass="refract">
        <texture unit="environment" name="viewport" />
    </command>
    <command type="scenepass" pass="alpha" vertexlights="true" sort="backtofront" metadata="alpha">
        <texture unit="depth" name="depth" />
    </command>
    <command type="scenepass" pass="postalpha" sort="backtofront" />
</renderpath>
