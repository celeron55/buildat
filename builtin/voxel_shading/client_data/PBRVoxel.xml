<!-- Voxel geometry shaded by the skylight the mesher packed into vertex
     colors. See PBRVoxel.glsl beside this file for what the colors mean.

     METALLIC reads the roughness/metalness atlas the atlas registry derives
     from each texture, VOXELNORMALMAP the normal atlas beside it, VOXELIBL
     reflects the zone cube map, dimmed in the directions the camera cannot see
     the sky along, VOXELSPOTS moves the glossy parts of a surface around over
     time and VOXELTRANSLUCENCY lets light through them from behind.
     A world that sets no zone cube map gets black reflections, so IBL is only
     useful together with Zone.zoneTexture, and the client has to keep the
     SkyVis parameter up to date; builtin/voxel_shading's module.lua does. -->
<technique vs="voxel_shading/PBRVoxel" ps="voxel_shading/PBRVoxel"
        psdefines="DIFFMAP PBR METALLIC VOXELNORMALMAP VOXELIBL VOXELSPOTS VOXELTRANSLUCENCY">
    <pass name="base" />
    <pass name="light" depthtest="equal" depthwrite="false" blend="add" />
    <pass name="depth" vs="Depth" ps="Depth" />
    <pass name="shadow" vs="Shadow" ps="Shadow" />
</technique>
