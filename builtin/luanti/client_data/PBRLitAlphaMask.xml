<!-- Urho3D's PBR lit forward passes with the texture's alpha cutting holes,
     for the held item under pbr ([WIELD_MESH]): the sun's direction and
     shadow map as the world's own light pass has them, the zone's ambient
     under that, which the material's colour scales to the light where the
     player stands. No IBL. It casts no shadow of its own, so the shadow pass
     is only for a caller that turns that on. -->
<technique vs="PBRLitSolid" ps="PBRLitSolid" psdefines="DIFFMAP ALPHAMASK PBR">
    <pass name="base" />
    <pass name="light" depthtest="equal" depthwrite="false" blend="add" />
    <pass name="shadow" vs="Shadow" ps="Shadow" psdefines="ALPHAMASK" />
</technique>
