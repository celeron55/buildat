<!-- Urho3D's Unlit with the texture's alpha cutting holes rather than being
     ignored or blended through. What wants it here is an item's picture --
     a plant, a tool, a sapling -- drawn as itself: opaque where the picture
     is and not there at all where it is not, which is what
     use_texture_alpha = "clip" means for a node and what an item image is
     too. CoreData has DiffUnlit (alpha ignored, so the holes are black) and
     DiffUnlitAlpha (blended, so a picture that is mostly holes is a ghost),
     and neither is this. -->
<technique vs="Unlit" ps="Unlit" psdefines="DIFFMAP ALPHAMASK">
    <pass name="base" />
</technique>
